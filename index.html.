<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<style>
:root{--bg:#04050d;--mu:#9aa3c7;--ln:rgba(255,255,255,.09);--b:#4d7cff;--p:#a05bff;--g:linear-gradient(90deg,#4d7cff,#a05bff);color-scheme:dark;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*,*::before,*::after{box-sizing:inherit}
html{scroll-behavior:smooth;scroll-padding-top:calc(70px + env(safe-area-inset-top,0px))}
body{margin:0;background:var(--bg);color:#fff;font:400 1rem/1.6 Inter,system-ui,sans-serif;overflow-x:hidden;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
:focus-visible{outline:2px solid #8aa6ff;outline-offset:3px}
.w{width:min(1180px,100% - 48px);margin-inline:auto;position:relative;z-index:1}
.lab{font:600 .66rem/1.4 Inter;letter-spacing:.17em;text-transform:uppercase;color:var(--mu)}
.lab b{color:#fff;font-weight:600}
.h{font-weight:800;letter-spacing:-.045em;line-height:1;margin:0;font-size:clamp(2.5rem,6.4vw,5.4rem)}
.h.m{font-size:clamp(2.1rem,4.8vw,4rem)}
.gt{background:var(--g);-webkit-background-clip:text;background-clip:text;color:transparent}
.sec{padding:130px 0 90px;position:relative;overflow:hidden}
.orb{position:absolute;border-radius:50%;filter:blur(120px);pointer-events:none}
.sub{color:var(--mu);max-width:36em;margin:22px 0 0;font-size:1.02rem}
.top{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap;margin-bottom:46px}
.top .lab{max-width:22em;text-align:right}

/* header */
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--bg);z-index:60}
header{position:fixed;top:env(safe-area-inset-top,0px);left:0;right:0;z-index:50;transition:background .3s}
header.s,header.o{background:rgba(4,5,13,.85);backdrop-filter:blur(14px);border-bottom:1px solid var(--ln)}
.nv{display:flex;align-items:center;justify-content:space-between;height:68px;gap:20px}
.lg{font-weight:800;font-size:1.02rem;letter-spacing:-.02em;display:flex;align-items:center;gap:9px}
.lg i{width:9px;height:9px;transform:rotate(45deg);background:var(--g);box-shadow:0 0 14px var(--b)}
.lg span{font-weight:400;color:var(--mu);font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;margin-left:-2px}
nav ul{display:flex;gap:34px;list-style:none;margin:0;padding:0}
nav a{font:600 .66rem Inter;letter-spacing:.17em;text-transform:uppercase;color:var(--mu);transition:color .2s;padding:6px 0;border-bottom:1px solid transparent}
nav a:hover,nav a.on{color:#fff}
.bt{display:inline-flex;align-items:center;justify-content:center;gap:10px;font:600 .95rem Inter;padding:15px 28px;border-radius:12px;border:1px solid transparent;cursor:pointer;transition:transform .2s,box-shadow .25s,background .2s}
.bt.p{background:var(--g);color:#fff;box-shadow:0 10px 34px -10px rgba(110,100,255,.8)}
.bt.p:hover{transform:translateY(-2px);box-shadow:0 14px 40px -8px rgba(130,100,255,.95)}
.bt.o{background:rgba(255,255,255,.04);border-color:var(--ln);color:#fff}
.bt.o:hover{background:rgba(255,255,255,.09)}
.bt.s{padding:10px 18px;font-size:.78rem;border-radius:99px}
.bg{display:none;background:none;border:0;width:44px;height:44px;cursor:pointer}
.bg span{display:block;width:22px;height:2px;background:#fff;margin:6px auto;transition:.3s}
.bg[aria-expanded=true] span:first-child{transform:translateY(4px) rotate(45deg)}
.bg[aria-expanded=true] span:last-child{transform:translateY(-4px) rotate(-45deg)}

/* intro */
#intro{min-height:100svh;display:flex;flex-direction:column;justify-content:center;padding:120px 0 40px;background-image:radial-gradient(rgba(255,255,255,.14) 1px,transparent 1.2px);background-size:22px 22px;background-position:right top;-webkit-mask:none}
#intro .dots{position:absolute;inset:0;background:linear-gradient(90deg,var(--bg) 35%,rgba(4,5,13,.55) 70%,transparent),linear-gradient(0deg,var(--bg),transparent 30%);z-index:0}
#intro .h{font-size:clamp(3.2rem,11vw,9.2rem);letter-spacing:-.055em;margin:26px 0 30px}
#intro .h span{display:block;animation:up .9s cubic-bezier(.2,.7,.2,1) both}
@keyframes up{from{opacity:0;transform:translateY(34px)}}
#intro p.sub{font-size:1.15rem;max-width:34em;color:#c4cae6;margin:0}
.ft{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-top:70px;padding-top:24px;border-top:1px solid var(--ln);flex-wrap:wrap}
.ft div{display:flex;gap:44px;align-items:flex-end}
.ft strong{font-size:1.25rem;font-weight:700;letter-spacing:-.02em;display:block;margin-top:4px}
.ft em{font-style:normal;color:var(--mu);font-weight:400}
.sc{display:flex;align-items:center;gap:12px}
.sc i{width:34px;height:34px;border:1px solid var(--ln);border-radius:50%;display:grid;place-items:center;font-style:normal;animation:bob 2s ease-in-out infinite}
@keyframes bob{50%{transform:translateY(5px)}}

/* hero */
.hr{display:grid;grid-template-columns:1fr 1fr;gap:30px;align-items:center}
.tg{display:inline-block;padding:7px 14px;border:1px solid var(--ln);border-radius:99px;background:rgba(255,255,255,.03);margin-bottom:26px}
.cta{display:flex;gap:14px;flex-wrap:wrap;margin-top:36px}
.pil{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:70px;border-top:1px solid var(--ln);padding-top:22px}
.pil strong{display:block;font-size:1.02rem;letter-spacing:-.01em;margin-top:4px}
.dev{position:relative;height:470px;perspective:1400px}
.dev>*{position:absolute}
.lap{left:8%;top:60px;width:84%;transform:rotateY(-16deg) rotateX(4deg);transform-style:preserve-3d;animation:fl 8s ease-in-out infinite}
.scr{aspect-ratio:16/10;border-radius:14px;border:6px solid #151a35;background:linear-gradient(135deg,#0b1240,#1d1156 60%,#3b1578);box-shadow:0 40px 80px -20px #000,0 0 80px -10px rgba(110,90,255,.55);padding:16px;overflow:hidden}
.scr i{display:block;height:7px;border-radius:4px;background:rgba(255,255,255,.2);margin:8px 0;width:55%}
.scr i:first-child{height:14px;width:70%;background:#fff;margin-top:20px}
.scr b{display:block;width:70px;height:20px;border-radius:6px;background:var(--g);margin:16px 0}
.scr div{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.scr div u{height:50px;border-radius:8px;background:rgba(255,255,255,.08);display:block}
.bs{height:12px;background:linear-gradient(#262c52,#10142e);border-radius:0 0 18px 18px;margin:0 -4%}
.tab{left:-2%;bottom:30px;width:34%;aspect-ratio:3/4;border-radius:16px;border:5px solid #151a35;background:linear-gradient(160deg,#0f2a8a,#3a1a7a);transform:rotateY(18deg);box-shadow:0 30px 60px -15px #000;animation:fl 7s ease-in-out -2s infinite}
.pho{right:2%;bottom:6px;width:19%;aspect-ratio:9/19;border-radius:20px;border:5px solid #151a35;background:linear-gradient(170deg,#3b1d8a,#0a1030);box-shadow:0 30px 60px -15px #000,0 0 50px -8px rgba(160,91,255,.7);animation:fl 6s ease-in-out -1s infinite}
@keyframes fl{50%{translate:0 -12px}}
.chip{padding:11px 15px;border-radius:12px;background:rgba(10,14,36,.88);backdrop-filter:blur(10px);border:1px solid var(--ln);box-shadow:0 14px 34px -10px #000;font-size:.82rem;font-weight:600}
.c1{left:6%;bottom:0}.c2{right:0;top:30px}
.chip .lab{display:flex;align-items:center;gap:7px;margin-bottom:2px}.chip .lab::before{content:"";width:7px;height:7px;border-radius:50%;background:#22d3a0;box-shadow:0 0 9px #22d3a0}

/* services */
.sv{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.cd{position:relative;padding:26px 26px 28px;border:1px solid var(--ln);border-radius:6px;background:rgba(255,255,255,.025);transition:border-color .3s,background .3s,transform .3s}
.cd::before{content:"";position:absolute;left:-1px;right:-1px;top:-1px;height:2px;background:var(--g);opacity:.55;transition:opacity .3s}
.cd:hover{border-color:rgba(130,140,255,.45);background:rgba(110,100,255,.07);transform:translateY(-4px)}.cd:hover::before{opacity:1}
.n{display:grid;place-items:center;width:34px;height:34px;border:1px solid rgba(77,124,255,.5);background:rgba(77,124,255,.1);color:#7aa0ff;border-radius:6px;font:700 .8rem Inter;margin-bottom:28px}
.cd h3{margin:0 0 6px;font-size:1.22rem;letter-spacing:-.025em}
.cd .lab{display:block;margin-bottom:14px;color:#7e88b4}
.cd p{margin:0;color:var(--mu);font-size:.93rem}

/* steps */
.sp{display:grid;grid-template-columns:repeat(4,1fr);gap:26px;position:relative;margin-top:60px}
.sp::before{content:"";position:absolute;left:0;right:0;top:92px;height:1px;background:linear-gradient(90deg,var(--b),var(--p),transparent)}
.sp>div{position:relative}
.sp .big{font-size:4rem;font-weight:800;letter-spacing:-.06em;line-height:1}
.sp .dt{position:absolute;left:0;top:87px;width:11px;height:11px;border-radius:50%;background:var(--b);box-shadow:0 0 0 5px rgba(77,124,255,.2),0 0 18px var(--b)}
.sp .bd{display:inline-block;margin:34px 0 14px;padding:4px 10px;border:1px solid rgba(160,91,255,.4);background:rgba(160,91,255,.1);border-radius:99px}
.sp h3{margin:0 0 8px;font-size:1.3rem;letter-spacing:-.03em}.sp p{margin:0;color:var(--mu);font-size:.93rem;max-width:20em}
.bn{margin-top:60px;padding:20px 26px;border:1px solid rgba(77,124,255,.3);background:rgba(77,124,255,.07);border-radius:10px;display:flex;justify-content:space-between;gap:16px;align-items:center;flex-wrap:wrap}
.bn p{margin:0}.bn strong{font-weight:700}.bn span{color:var(--mu)}

/* portfolio */
.pf{display:grid;grid-template-columns:1.45fr 1fr;gap:22px}
.ft1{border:1px solid var(--ln);border-radius:12px;background:rgba(255,255,255,.025);padding:18px;display:grid;grid-template-columns:1.2fr 1fr;gap:24px;align-items:center}
.mk{border-radius:8px;overflow:hidden;border:1px solid var(--ln);background:#0c0e14;aspect-ratio:4/3;position:relative}
.mk .nb{height:16px;background:#14161d;display:flex;gap:4px;padding:5px 8px}.mk .nb i{width:5px;height:5px;border-radius:50%;background:#333a4d}
.mk .ph{position:absolute;right:-10%;top:26%;width:56%;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle at 40% 35%,#e8a65c,#8b3d17 60%,#2a1208);box-shadow:0 0 40px rgba(232,140,60,.35)}
.mk .tt{position:absolute;left:8%;top:34%;font-weight:800;font-size:1.55rem;letter-spacing:-.04em;line-height:1;max-width:60%}
.mk .or{position:absolute;left:8%;bottom:16%;width:64px;height:16px;border-radius:4px;background:#f08a2d}
.mk .nl{position:absolute;top:21px;right:8%;display:flex;gap:10px;font-size:.5rem;color:#9aa0b4}.mk .cds{position:absolute;left:8%;right:8%;bottom:0;display:flex;gap:6px}.mk .cds u{flex:1;height:24px;border-radius:5px 5px 0 0;background:#171a24;border:1px solid #2a2f42;border-bottom:0}.ft1 h3{font-size:2rem;margin:10px 0;letter-spacing:-.04em}.ft1 p{color:var(--mu);margin:0 0 18px;font-size:.95rem}
.tags{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:22px}.tags span{padding:5px 10px;border:1px solid rgba(160,91,255,.4);background:rgba(160,91,255,.1);border-radius:99px;font:600 .62rem Inter;letter-spacing:.12em;text-transform:uppercase;color:#cdb6ff}
.lk{font:600 .66rem Inter;letter-spacing:.17em;text-transform:uppercase;display:inline-flex;align-items:center;gap:10px}.lk::before{content:"";width:28px;height:1px;background:var(--b)}
.li{display:grid;gap:14px}
.it{display:grid;grid-template-columns:120px 1fr;gap:16px;align-items:center;padding:12px;border:1px solid var(--ln);border-radius:10px;background:rgba(255,255,255,.025);transition:border-color .3s}
.it:hover{border-color:rgba(130,140,255,.45)}
.it .th{aspect-ratio:4/3;border-radius:6px;position:relative;overflow:hidden}
.it .th{padding:9% 9% 0;display:flex;flex-direction:column;gap:5px}.th i{display:block;border-radius:3px;background:rgba(255,255,255,.92)}.th .g{display:flex;gap:4px;margin-top:auto}.th .g u{flex:1;height:22px;border-radius:4px 4px 0 0;background:rgba(0,0,0,.28);border:1px solid rgba(255,255,255,.25);border-bottom:0}
.it h4{margin:6px 0 3px;font-size:1.05rem;letter-spacing:-.02em}.it p{margin:0;color:var(--mu);font-size:.82rem;line-height:1.45}

.mk img{position:absolute;top:16px;left:0;width:100%;height:calc(100% - 16px);object-fit:cover;object-position:top}.it .th{padding:0;display:block}.it .th img{width:100%;height:100%;object-fit:cover;object-position:top;display:block}
/* manifest */
.mn{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-top:56px}
.mn>div{padding:22px 26px;border:1px solid var(--ln);border-left:2px solid var(--b);border-radius:6px;background:rgba(255,255,255,.025)}
.mn>div:nth-child(even){border-left-color:var(--p)}
.mn h3{margin:8px 0 6px;font-size:1.25rem;letter-spacing:-.03em}.mn p{margin:0;color:var(--mu);font-size:.92rem}

/* contact */
#contato{text-align:center;padding-bottom:50px}
#contato .h{margin:28px auto 22px;max-width:9.5em}
#contato .sub{margin:0 auto 38px}
#contato .bt{padding:18px 44px;font-size:1.05rem;border-radius:14px;animation:pl 2.8s infinite}
@keyframes pl{0%{box-shadow:0 0 0 0 rgba(130,100,255,.55)}70%,100%{box-shadow:0 0 0 24px rgba(130,100,255,0)}}
.ci{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:80px;text-align:left}
.ci a,.ci div{display:flex;gap:16px;align-items:center;padding:18px 22px;border:1px solid var(--ln);border-radius:12px;background:rgba(255,255,255,.03)}
.ci i{width:38px;height:38px;border-radius:9px;display:grid;place-items:center;font:700 .8rem Inter;font-style:normal;background:var(--g)}
.ci strong{display:block;font-size:1.05rem;letter-spacing:-.01em}
footer{border-top:1px solid var(--ln);padding:26px 0;margin-top:40px}
footer .w{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}
.rv{opacity:0;transform:translateY(24px);transition:opacity .8s,transform .8s}.rv.on{opacity:1;transform:none}

@media(max-width:980px){
.hr{grid-template-columns:1fr}.dev{height:400px;max-width:560px;width:100%;margin:30px auto 0}
.sv{grid-template-columns:repeat(2,1fr)}.sp{grid-template-columns:repeat(2,1fr);row-gap:50px}.sp::before,.sp .dt{display:none}.sp .bd{margin-top:22px}
.pf{grid-template-columns:1fr}.top .lab{text-align:left}}
@media(max-width:760px){
.sec{padding:100px 0 60px}
.bg{display:block}
nav{position:fixed;inset:calc(68px + env(safe-area-inset-top,0px)) 0 auto;background:rgba(4,5,13,.97);border-bottom:1px solid var(--ln);padding:8px 24px 22px;transform:translateY(-130%);visibility:hidden;transition:transform .35s}
nav.open{transform:none;visibility:visible}nav ul{flex-direction:column;gap:0}nav li a{display:block;padding:17px 0;border-bottom:1px solid var(--ln)}
.nv>.bt{display:none}
.sv,.mn,.sp,.ci{grid-template-columns:1fr}.pil{grid-template-columns:1fr;gap:14px}.ft1{grid-template-columns:1fr}
.ft div{gap:26px}.sc{display:none}.cta .bt{width:100%}.dev{height:340px}.it{grid-template-columns:96px 1fr}.bn{padding:18px}
#contato .bt{width:100%;padding-inline:20px}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}html{scroll-behavior:auto}.rv{opacity:1;transform:none}}
</style>
</head>
